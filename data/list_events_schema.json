{
  "$schema": "https://json-schema.org",
  "title": "EventListResponse",
  "description": "Schema for paginated event listing API response",
  "type": "object",
  "required": [
    "success",
    "data",
    "pagination"
  ],
  "additionalProperties": false,
  "properties": {
    "success": {
      "type": "boolean",
      "description": "Indicates whether the API request succeeded"
    },
    "data": {
      "type": "array",
      "description": "List of event objects",
      "items": {
        "$ref": "#/$defs/EventItem"
      }
    },
    "pagination": {
      "$ref": "#/$defs/Pagination"
    }
  },
  "$defs": {
    "EventItem": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "category",
        "venue",
        "city",
        "eventDate",
        "price",
        "totalSeats",
        "availableSeats",
        "imageUrl",
        "isStatic",
        "userId",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "venue": {
          "type": "string",
          "minLength": 1
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "eventDate": {
          "type": "string",
          "format": "date-time"
        },
        "price": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]{1,2})?$",
          "description": "Numeric price represented as a string"
        },
        "totalSeats": {
          "type": "integer",
          "minimum": 0
        },
        "availableSeats": {
          "type": "integer",
          "minimum": 0
        },
        "imageUrl": {
          "type": "string",
          "format": "uri"
        },
        "isStatic": {
          "type": "boolean"
        },
        "userId": {
          "type": ["integer", "null"],
          "description": "ID of the creator user, or null for static/system events"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Pagination": {
      "type": "object",
      "required": [
        "total",
        "page",
        "limit",
        "totalPages"
      ],
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "totalPages": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
